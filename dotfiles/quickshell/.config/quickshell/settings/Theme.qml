pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Material You colours, regenerated by matugen whenever the wallpaper changes.
Singleton {
    id: root

    readonly property string font: "JetBrainsMono Nerd Font"
    readonly property int radius: 18

    readonly property color primary: c.primary
    readonly property color fgPrimary: c.fgPrimary
    readonly property color primaryContainer: c.primaryContainer
    readonly property color fgPrimaryContainer: c.fgPrimaryContainer
    readonly property color secondary: c.secondary
    readonly property color secondaryContainer: c.secondaryContainer
    readonly property color fgSecondaryContainer: c.fgSecondaryContainer
    readonly property color tertiary: c.tertiary
    readonly property color error: c.error
    readonly property color surface: c.surface
    readonly property color surfaceLow: c.surfaceContainerLow
    readonly property color surfaceMid: c.surfaceContainer
    readonly property color surfaceHigh: c.surfaceContainerHigh
    readonly property color surfaceHighest: c.surfaceContainerHighest
    readonly property color text: c.fgSurface
    readonly property color subtext: c.fgSurfaceVariant
    readonly property color outline: c.outline
    readonly property color outlineVariant: c.outlineVariant

    FileView {
        path: Quickshell.env("HOME") + "/.config/quickshell/settings/colors.json"
        watchChanges: true
        onFileChanged: reload()

        JsonAdapter {
            id: c
            property string primary: "#ffb2b7"
            property string fgPrimary: "#561d24"
            property string primaryContainer: "#723339"
            property string fgPrimaryContainer: "#ffdadb"
            property string secondary: "#e6bdbe"
            property string secondaryContainer: "#5c3f41"
            property string fgSecondaryContainer: "#ffdadb"
            property string tertiary: "#e7c08e"
            property string error: "#ffb4ab"
            property string surface: "#1a1112"
            property string surfaceContainerLow: "#22191a"
            property string surfaceContainer: "#271d1e"
            property string surfaceContainerHigh: "#322828"
            property string surfaceContainerHighest: "#3d3232"
            property string fgSurface: "#f0dede"
            property string fgSurfaceVariant: "#d7c1c2"
            property string outline: "#9f8c8d"
            property string outlineVariant: "#524344"
        }
    }
}

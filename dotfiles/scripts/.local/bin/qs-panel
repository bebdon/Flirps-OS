#!/usr/bin/env bash
# Toggle a Quickshell overlay: qs-panel launcher|power|clipboard|wallpapers
# Starts the resident "panels" process if it isn't running.
t="${1:-launcher}"
qs -c panels ipc call "$t" toggle >/dev/null 2>&1 && exit
setsid -f qs -c panels >/dev/null 2>&1
for _ in $(seq 30); do
    sleep 0.1
    qs -c panels ipc call "$t" toggle >/dev/null 2>&1 && exit
done

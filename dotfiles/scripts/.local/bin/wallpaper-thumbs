#!/usr/bin/env bash
# Make small preview images for the wallpaper picker.
DIR="$HOME/Pictures/Wallpapers"
OUT="$HOME/.cache/wallpaper/thumbs"
mkdir -p "$OUT"
find "$DIR/" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 |
while IFS= read -r -d '' f; do
    t="$OUT/$(basename "$f").jpg"
    [ -f "$t" ] && [ "$t" -nt "$f" ] && continue
    magick "$f[0]" -thumbnail 480x300^ -gravity center -extent 480x300 -quality 85 "$t" 2>/dev/null
done

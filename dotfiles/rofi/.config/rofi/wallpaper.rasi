@import "colors.rasi"

configuration {
    show-icons: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    y-offset: 0;
    width: 94%;
    border: 1px;
    border-color: @border-c;
    border-radius: 16px;
    background-color: @bg;
    padding: 14px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 8px 14px;
    spacing: 10px;
}

prompt { text-color: @accent; }
entry { placeholder: "Search wallpapers…"; placeholder-color: @fg-dim; }

listview {
    layout: vertical;
    flow: horizontal;
    lines: 1;
    columns: 6;
    fixed-height: true;
    fixed-columns: true;
    spacing: 12px;
    scrollbar: false;
    cycle: true;
}

element {
    orientation: vertical;
    padding: 6px;
    border-radius: 12px;
    spacing: 0;
}

element selected.normal {
    background-color: @accent;
}

element-icon {
    size: 200px;
    border-radius: 10px;
    horizontal-align: 0.5;
}

element-text { enabled: false; }
